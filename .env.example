# ─── Phase 1: Required at startup ────────────────────────────────────────────
PORT=3000
REDIS_URL=redis://127.0.0.1:6379

# ─── Phase 2: x402 payment gate ──────────────────────────────────────────────
# Public host used in the 402 resource URL (e.g. https://tollgate.yourdomain.com)
# Falls back to req.headers.host if not set — wrong behind reverse proxies
PUBLIC_HOST=

# ─── Phase 3: On-chain USDC verification ─────────────────────────────────────
ALCHEMY_API_KEY=
# Testnet (Base Sepolia)
BASE_CHAIN_ID=84532
USDC_CONTRACT_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
# Mainnet (uncomment when ready for production)
# BASE_CHAIN_ID=8453
# USDC_CONTRACT_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
PAYMENT_RECIPIENT_ADDRESS=
PAYMENT_AMOUNT_USDC=0.01

# ─── Phase 4: Redis session store ────────────────────────────────────────────
SESSION_TTL_SECONDS=3600
# Set to true in production — makes Redis downtime fail closed (503) instead of
# open, preventing replay attacks during Redis restarts
STRICT_REPLAY_CHECK=false

# ─── Phase 5: WireGuard provisioning ─────────────────────────────────────────
WG_INTERFACE=wg0
WG_SERVER_PUBLIC_KEY=
WG_SERVER_ENDPOINT=
WG_SERVER_PORT=51820
WG_DNS=1.1.1.1

# ─── Phase 6: Agent simulation (never commit) ────────────────────────────────
OPENFORT_SECRET_KEY=
OPENFORT_WALLET_SECRET=
OPENFORT_ACCOUNT_ID=
TOLLGATE_URL=http://localhost:3000
